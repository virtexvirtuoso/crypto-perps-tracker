// Short ticker names
var string[] tickerNames = array.from("BTC", "ETH", "XRP", "BNB", "SOL", "DOGE", "AVAX", "LINK", "TNSR", "ZEC", "XMR", "ICP", "TRX", "LTC", "KAS", "ETC", "NEAR", "ATOM", "GRASS", "HYPE", "WLD", "ONDO", "FARTCOIN", "PIPPIN", "PIEVERSE", "JELLY", "EDEN", "TAKE", "MYX", "OG", "FF", "XPIN")

// ============================================
// FETCH PRICE DATA
// ============================================
float p01 = request.security(sym01, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p02 = request.security(sym02, timeframe.period, close, lookahead=barmerge.lookahead_off)
