float p26 = request.security(sym26, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p27 = request.security(sym27, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p28 = request.security(sym28, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p29 = request.security(sym29, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p30 = request.security(sym30, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p31 = request.security(sym31, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p32 = request.security(sym32, timeframe.period, close, lookahead=barmerge.lookahead_off)

// ============================================
// RETURN CALCULATION FUNCTIONS
// ============================================
getBasePrice(float price, string mode, int lookback) =>
    float anchorPrice = ta.valuewhen(time >= anchorTime and time[1] < anchorTime, price, 0)
    float result = switch mode
        "Rolling" => price[lookback]
        "Anchor Date" => na(anchorPrice) ? price[lookback] : anchorPrice
        "Zoom (Visible)" => price[math.min(bar_index, 500)]
        => price[lookback]
    result

calcReturn(float price, float basePrice) =>
    basePrice > 0 ? ((price - basePrice) / basePrice) * 100 : 0.0

// ============================================
// CHART SYMBOL (for relative comparison)
// ============================================
float chartPrice = close
float chartBase = getBasePrice(chartPrice, modeInput, lookbackInput)
float chartReturn = calcReturn(chartPrice, chartBase)

// ============================================
// CALCULATE ALL RETURNS (individual variables for proper historical refs)
// ============================================
// Base prices - called at global scope for consistency
float base01 = getBasePrice(p01, modeInput, lookbackInput)
float base02 = getBasePrice(p02, modeInput, lookbackInput)
float base03 = getBasePrice(p03, modeInput, lookbackInput)
float base04 = getBasePrice(p04, modeInput, lookbackInput)
float base05 = getBasePrice(p05, modeInput, lookbackInput)
float base06 = getBasePrice(p06, modeInput, lookbackInput)
float base07 = getBasePrice(p07, modeInput, lookbackInput)
float base08 = getBasePrice(p08, modeInput, lookbackInput)
float base09 = getBasePrice(p09, modeInput, lookbackInput)
float base10 = getBasePrice(p10, modeInput, lookbackInput)
float base11 = getBasePrice(p11, modeInput, lookbackInput)
float base12 = getBasePrice(p12, modeInput, lookbackInput)
float base13 = getBasePrice(p13, modeInput, lookbackInput)
float base14 = getBasePrice(p14, modeInput, lookbackInput)
float base15 = getBasePrice(p15, modeInput, lookbackInput)
float base16 = getBasePrice(p16, modeInput, lookbackInput)
float base17 = getBasePrice(p17, modeInput, lookbackInput)
float base18 = getBasePrice(p18, modeInput, lookbackInput)
float base19 = getBasePrice(p19, modeInput, lookbackInput)
float base20 = getBasePrice(p20, modeInput, lookbackInput)
float base21 = getBasePrice(p21, modeInput, lookbackInput)
float base22 = getBasePrice(p22, modeInput, lookbackInput)
float base23 = getBasePrice(p23, modeInput, lookbackInput)
float base24 = getBasePrice(p24, modeInput, lookbackInput)
float base25 = getBasePrice(p25, modeInput, lookbackInput)
float base26 = getBasePrice(p26, modeInput, lookbackInput)
float base27 = getBasePrice(p27, modeInput, lookbackInput)
float base28 = getBasePrice(p28, modeInput, lookbackInput)
float base29 = getBasePrice(p29, modeInput, lookbackInput)
float base30 = getBasePrice(p30, modeInput, lookbackInput)
float base31 = getBasePrice(p31, modeInput, lookbackInput)
float base32 = getBasePrice(p32, modeInput, lookbackInput)

// Raw returns
float rawRet01 = calcReturn(p01, base01)
float rawRet02 = calcReturn(p02, base02)
float rawRet03 = calcReturn(p03, base03)
float rawRet04 = calcReturn(p04, base04)
float rawRet05 = calcReturn(p05, base05)
float rawRet06 = calcReturn(p06, base06)
float rawRet07 = calcReturn(p07, base07)
float rawRet08 = calcReturn(p08, base08)
float rawRet09 = calcReturn(p09, base09)
float rawRet10 = calcReturn(p10, base10)
float rawRet11 = calcReturn(p11, base11)
float rawRet12 = calcReturn(p12, base12)
float rawRet13 = calcReturn(p13, base13)
float rawRet14 = calcReturn(p14, base14)
float rawRet15 = calcReturn(p15, base15)
float rawRet16 = calcReturn(p16, base16)
float rawRet17 = calcReturn(p17, base17)
float rawRet18 = calcReturn(p18, base18)
float rawRet19 = calcReturn(p19, base19)
float rawRet20 = calcReturn(p20, base20)
float rawRet21 = calcReturn(p21, base21)
float rawRet22 = calcReturn(p22, base22)
float rawRet23 = calcReturn(p23, base23)
float rawRet24 = calcReturn(p24, base24)
float rawRet25 = calcReturn(p25, base25)
float rawRet26 = calcReturn(p26, base26)
float rawRet27 = calcReturn(p27, base27)
float rawRet28 = calcReturn(p28, base28)
float rawRet29 = calcReturn(p29, base29)
float rawRet30 = calcReturn(p30, base30)
float rawRet31 = calcReturn(p31, base31)
float rawRet32 = calcReturn(p32, base32)

// Apply relative mode
float relAdj = relativeMode ? chartReturn : 0.0
float ret01 = rawRet01 - relAdj
float ret02 = rawRet02 - relAdj
float ret03 = rawRet03 - relAdj
float ret04 = rawRet04 - relAdj
float ret05 = rawRet05 - relAdj
float ret06 = rawRet06 - relAdj
float ret07 = rawRet07 - relAdj
float ret08 = rawRet08 - relAdj
float ret09 = rawRet09 - relAdj
float ret10 = rawRet10 - relAdj
float ret11 = rawRet11 - relAdj
float ret12 = rawRet12 - relAdj
float ret13 = rawRet13 - relAdj
float ret14 = rawRet14 - relAdj
float ret15 = rawRet15 - relAdj
float ret16 = rawRet16 - relAdj
float ret17 = rawRet17 - relAdj
float ret18 = rawRet18 - relAdj
float ret19 = rawRet19 - relAdj
float ret20 = rawRet20 - relAdj
float ret21 = rawRet21 - relAdj
float ret22 = rawRet22 - relAdj
float ret23 = rawRet23 - relAdj
float ret24 = rawRet24 - relAdj
float ret25 = rawRet25 - relAdj
float ret26 = rawRet26 - relAdj
float ret27 = rawRet27 - relAdj
float ret28 = rawRet28 - relAdj
float ret29 = rawRet29 - relAdj
float ret30 = rawRet30 - relAdj
float ret31 = rawRet31 - relAdj
float ret32 = rawRet32 - relAdj

// ============================================
// STATISTICS
// ============================================
float[] retArray = array.from(ret01, ret02, ret03, ret04, ret05, ret06, ret07, ret08, ret09, ret10, ret11, ret12, ret13, ret14, ret15, ret16, ret17, ret18, ret19, ret20, ret21, ret22, ret23, ret24, ret25, ret26, ret27, ret28, ret29, ret30, ret31, ret32)

float meanRet = array.avg(retArray)
float stdRet = array.stdev(retArray)
float maxRet = array.max(retArray)
float minRet = array.min(retArray)
float spreadRet = maxRet - minRet

int numAssets = 32
int numHighlight = math.round(numAssets * (highlightPct / 100))
float[] sortedRets = array.copy(retArray)
array.sort(sortedRets, order.descending)
float topThreshold = array.get(sortedRets, math.max(0, numHighlight - 1))
// v6 feature: negative array indexing
float bottomThreshold = array.get(sortedRets, -numHighlight)

// ============================================
// DYNAMIC PLOT ASSIGNMENT
// ============================================
int[] sortedIndices = array.new_int(32)
for i = 0 to 31
    array.set(sortedIndices, i, i)

for i = 0 to 30
    for j = 0 to 30 - i
        int idxJ = array.get(sortedIndices, j)
        int idxJ1 = array.get(sortedIndices, j + 1)
        if array.get(retArray, idxJ) < array.get(retArray, idxJ1)
            array.set(sortedIndices, j, idxJ1)
            array.set(sortedIndices, j + 1, idxJ)

var int[] topIndices = array.new_int(10, 0)
var int[] bottomIndices = array.new_int(10, 0)
for i = 0 to 9
    array.set(topIndices, i, array.get(sortedIndices, i))
    // v6: negative indexing
    array.set(bottomIndices, i, array.get(sortedIndices, -(i + 1)))

// Helper functions
getRetByIdx(int idx) =>
    switch idx
        0 => ret01
        1 => ret02
        2 => ret03
        3 => ret04
        4 => ret05
        5 => ret06
        6 => ret07
        7 => ret08
        8 => ret09
        9 => ret10
        10 => ret11
        11 => ret12
        12 => ret13
        13 => ret14
        14 => ret15
        15 => ret16
        16 => ret17
        17 => ret18
        18 => ret19
        19 => ret20
        20 => ret21
        21 => ret22
        22 => ret23
        23 => ret24
        24 => ret25
        25 => ret26
        26 => ret27
        27 => ret28
        28 => ret29
        29 => ret30
        30 => ret31
        => ret32

getColorByIdx(int idx) =>
    switch idx
        0 => c01
        1 => c02
        2 => c03
        3 => c04
        4 => c05
        5 => c06
        6 => c07
        7 => c08
        8 => c09
        9 => c10
        10 => c11
        11 => c12
        12 => c13
        13 => c14
        14 => c15
        15 => c16
        16 => c17
        17 => c18
        18 => c19
        19 => c20
        20 => c21
        21 => c22
        22 => c23
        23 => c24
        24 => c25
        25 => c26
        26 => c27
        27 => c28
        28 => c29
        29 => c30
        30 => c31
        => c32

// Get dynamic values for plot slots
float topVal01 = getRetByIdx(array.get(topIndices, 0))
float topVal02 = getRetByIdx(array.get(topIndices, 1))
float topVal03 = getRetByIdx(array.get(topIndices, 2))
float topVal04 = getRetByIdx(array.get(topIndices, 3))
float topVal05 = getRetByIdx(array.get(topIndices, 4))
float topVal06 = getRetByIdx(array.get(topIndices, 5))
float topVal07 = getRetByIdx(array.get(topIndices, 6))
float topVal08 = getRetByIdx(array.get(topIndices, 7))
float topVal09 = getRetByIdx(array.get(topIndices, 8))
float topVal10 = getRetByIdx(array.get(topIndices, 9))

float botVal01 = getRetByIdx(array.get(bottomIndices, 0))
float botVal02 = getRetByIdx(array.get(bottomIndices, 1))
float botVal03 = getRetByIdx(array.get(bottomIndices, 2))
float botVal04 = getRetByIdx(array.get(bottomIndices, 3))
float botVal05 = getRetByIdx(array.get(bottomIndices, 4))
float botVal06 = getRetByIdx(array.get(bottomIndices, 5))
float botVal07 = getRetByIdx(array.get(bottomIndices, 6))
float botVal08 = getRetByIdx(array.get(bottomIndices, 7))
float botVal09 = getRetByIdx(array.get(bottomIndices, 8))
float botVal10 = getRetByIdx(array.get(bottomIndices, 9))

color topCol01 = getColorByIdx(array.get(topIndices, 0))
color topCol02 = getColorByIdx(array.get(topIndices, 1))
color topCol03 = getColorByIdx(array.get(topIndices, 2))
color topCol04 = getColorByIdx(array.get(topIndices, 3))
color topCol05 = getColorByIdx(array.get(topIndices, 4))
color topCol06 = getColorByIdx(array.get(topIndices, 5))
color topCol07 = getColorByIdx(array.get(topIndices, 6))
color topCol08 = getColorByIdx(array.get(topIndices, 7))
color topCol09 = getColorByIdx(array.get(topIndices, 8))
color topCol10 = getColorByIdx(array.get(topIndices, 9))

color botCol01 = getColorByIdx(array.get(bottomIndices, 0))
color botCol02 = getColorByIdx(array.get(bottomIndices, 1))
color botCol03 = getColorByIdx(array.get(bottomIndices, 2))
color botCol04 = getColorByIdx(array.get(bottomIndices, 3))
color botCol05 = getColorByIdx(array.get(bottomIndices, 4))
color botCol06 = getColorByIdx(array.get(bottomIndices, 5))
color botCol07 = getColorByIdx(array.get(bottomIndices, 6))
color botCol08 = getColorByIdx(array.get(bottomIndices, 7))
color botCol09 = getColorByIdx(array.get(bottomIndices, 8))
color botCol10 = getColorByIdx(array.get(bottomIndices, 9))

// ============================================
// BREAKOUT DETECTION
// ============================================
float change01 = ret01 - nz(ret01[1])
float change02 = ret02 - nz(ret02[1])
float change03 = ret03 - nz(ret03[1])
float change04 = ret04 - nz(ret04[1])
float change05 = ret05 - nz(ret05[1])
float change06 = ret06 - nz(ret06[1])
float change07 = ret07 - nz(ret07[1])
float change08 = ret08 - nz(ret08[1])
float change09 = ret09 - nz(ret09[1])
float change10 = ret10 - nz(ret10[1])
float change11 = ret11 - nz(ret11[1])
float change12 = ret12 - nz(ret12[1])
float change13 = ret13 - nz(ret13[1])
float change14 = ret14 - nz(ret14[1])
float change15 = ret15 - nz(ret15[1])
float change16 = ret16 - nz(ret16[1])
float change17 = ret17 - nz(ret17[1])
float change18 = ret18 - nz(ret18[1])
float change19 = ret19 - nz(ret19[1])
float change20 = ret20 - nz(ret20[1])
float change21 = ret21 - nz(ret21[1])
float change22 = ret22 - nz(ret22[1])
float change23 = ret23 - nz(ret23[1])
float change24 = ret24 - nz(ret24[1])
float change25 = ret25 - nz(ret25[1])
float change26 = ret26 - nz(ret26[1])
float change27 = ret27 - nz(ret27[1])
float change28 = ret28 - nz(ret28[1])
float change29 = ret29 - nz(ret29[1])
float change30 = ret30 - nz(ret30[1])
float change31 = ret31 - nz(ret31[1])
float change32 = ret32 - nz(ret32[1])

isBreakout(float change, float threshold) =>
    math.abs(change) >= threshold

var int lastBreakoutBar = 0
var int lastDivergenceBar = 0
var int lastSpreadBar = 0

bool canAlertBreakout = bar_index - lastBreakoutBar >= alertCooldown
bool canAlertDivergence = bar_index - lastDivergenceBar >= alertCooldown
bool canAlertSpread = bar_index - lastSpreadBar >= alertCooldown

bool breakout01 = isBreakout(change01, breakoutThreshold)
bool breakout02 = isBreakout(change02, breakoutThreshold)
bool breakout03 = isBreakout(change03, breakoutThreshold)
bool breakout04 = isBreakout(change04, breakoutThreshold)
bool breakout05 = isBreakout(change05, breakoutThreshold)
bool breakout06 = isBreakout(change06, breakoutThreshold)
bool breakout07 = isBreakout(change07, breakoutThreshold)
bool breakout08 = isBreakout(change08, breakoutThreshold)
bool breakout09 = isBreakout(change09, breakoutThreshold)
bool breakout10 = isBreakout(change10, breakoutThreshold)
bool breakout11 = isBreakout(change11, breakoutThreshold)
bool breakout12 = isBreakout(change12, breakoutThreshold)
bool breakout13 = isBreakout(change13, breakoutThreshold)
bool breakout14 = isBreakout(change14, breakoutThreshold)
bool breakout15 = isBreakout(change15, breakoutThreshold)
bool breakout16 = isBreakout(change16, breakoutThreshold)
bool breakout17 = isBreakout(change17, breakoutThreshold)
bool breakout18 = isBreakout(change18, breakoutThreshold)
bool breakout19 = isBreakout(change19, breakoutThreshold)
bool breakout20 = isBreakout(change20, breakoutThreshold)
bool breakout21 = isBreakout(change21, breakoutThreshold)
bool breakout22 = isBreakout(change22, breakoutThreshold)
bool breakout23 = isBreakout(change23, breakoutThreshold)
bool breakout24 = isBreakout(change24, breakoutThreshold)
bool breakout25 = isBreakout(change25, breakoutThreshold)
bool breakout26 = isBreakout(change26, breakoutThreshold)
bool breakout27 = isBreakout(change27, breakoutThreshold)
bool breakout28 = isBreakout(change28, breakoutThreshold)
bool breakout29 = isBreakout(change29, breakoutThreshold)
bool breakout30 = isBreakout(change30, breakoutThreshold)
bool breakout31 = isBreakout(change31, breakoutThreshold)
bool breakout32 = isBreakout(change32, breakoutThreshold)

bool anyBreakout = breakout01 or breakout02 or breakout03 or breakout04 or breakout05 or breakout06 or breakout07 or breakout08 or
                   breakout09 or breakout10 or breakout11 or breakout12 or breakout13 or breakout14 or breakout15 or breakout16 or
                   breakout17 or breakout18 or breakout19 or breakout20 or breakout21 or breakout22 or breakout23 or breakout24 or
                   breakout25 or breakout26 or breakout27 or breakout28 or breakout29 or breakout30 or breakout31 or breakout32

// ============================================
// DIVERGENCE DETECTION
// ============================================
float altcoinAvg = (ret02 + ret03 + ret04 + ret05 + ret06 + ret07 + ret08 + ret09 + ret10 + ret11 + ret12 + ret13 + ret14 + ret15 + ret16 + ret17 + ret18 + ret19 + ret20 + ret21 + ret22 + ret23 + ret24 + ret25 + ret26 + ret27 + ret28 + ret29 + ret30 + ret31 + ret32) / 31

float btcAltDivergence = ret01 - altcoinAvg
bool btcAltDivergenceAlert = math.abs(btcAltDivergence) >= divergenceThreshold

float ethBtcDivergence = ret02 - ret01
bool ethBtcDivergenceAlert = math.abs(ethBtcDivergence) >= divergenceThreshold

float largeCap = (ret01 + ret02 + ret03 + ret04 + ret05) / 5
float smallCap = (ret23 + ret24 + ret25 + ret26 + ret27 + ret28 + ret29 + ret30 + ret31 + ret32) / 10
float capDivergence = largeCap - smallCap
bool capDivergenceAlert = math.abs(capDivergence) >= divergenceThreshold

bool spreadAlert = spreadRet >= spreadThreshold

// ============================================
// LEADER / LAGGARD DETECTION
// ============================================
int leaderIdx = array.indexof(retArray, maxRet)
int laggardIdx = array.indexof(retArray, minRet)

var int prevLeaderIdx = 0
var int prevLaggardIdx = 0

bool newLeader = leaderIdx != prevLeaderIdx and bar_index > 0
bool newLaggard = laggardIdx != prevLaggardIdx and bar_index > 0

if barstate.isconfirmed
    prevLeaderIdx := leaderIdx
    prevLaggardIdx := laggardIdx
    if anyBreakout and canAlertBreakout
        lastBreakoutBar := bar_index
    if (btcAltDivergenceAlert or ethBtcDivergenceAlert or capDivergenceAlert) and canAlertDivergence
        lastDivergenceBar := bar_index
    if spreadAlert and canAlertSpread
        lastSpreadBar := bar_index

// ============================================
// CLUSTER BREAKOUT DETECTION - Pre-calculate wasMiddle at global scope
// ============================================
isExtreme(float ret) =>
    ret >= meanRet + (stdRet * 2) or ret <= meanRet - (stdRet * 2)

// Pre-calculate wasMiddle for all symbols at global scope
float prevMean = nz(meanRet[1])
float prevStd = nz(stdRet[1])
bool wasMiddle01 = math.abs(ret01[1] - prevMean) < (prevStd * dimThreshold)
bool wasMiddle02 = math.abs(ret02[1] - prevMean) < (prevStd * dimThreshold)
bool wasMiddle03 = math.abs(ret03[1] - prevMean) < (prevStd * dimThreshold)
bool wasMiddle04 = math.abs(ret04[1] - prevMean) < (prevStd * dimThreshold)
bool wasMiddle05 = math.abs(ret05[1] - prevMean) < (prevStd * dimThreshold)
bool wasMiddle06 = math.abs(ret06[1] - prevMean) < (prevStd * dimThreshold)
bool wasMiddle07 = math.abs(ret07[1] - prevMean) < (prevStd * dimThreshold)
bool wasMiddle08 = math.abs(ret08[1] - prevMean) < (prevStd * dimThreshold)
bool wasMiddle09 = math.abs(ret09[1] - prevMean) < (prevStd * dimThreshold)
bool wasMiddle10 = math.abs(ret10[1] - prevMean) < (prevStd * dimThreshold)
bool wasMiddle11 = math.abs(ret11[1] - prevMean) < (prevStd * dimThreshold)
bool wasMiddle12 = math.abs(ret12[1] - prevMean) < (prevStd * dimThreshold)
bool wasMiddle13 = math.abs(ret13[1] - prevMean) < (prevStd * dimThreshold)
bool wasMiddle14 = math.abs(ret14[1] - prevMean) < (prevStd * dimThreshold)
bool wasMiddle15 = math.abs(ret15[1] - prevMean) < (prevStd * dimThreshold)
bool wasMiddle16 = math.abs(ret16[1] - prevMean) < (prevStd * dimThreshold)
bool wasMiddle17 = math.abs(ret17[1] - prevMean) < (prevStd * dimThreshold)
bool wasMiddle18 = math.abs(ret18[1] - prevMean) < (prevStd * dimThreshold)
bool wasMiddle19 = math.abs(ret19[1] - prevMean) < (prevStd * dimThreshold)
bool wasMiddle20 = math.abs(ret20[1] - prevMean) < (prevStd * dimThreshold)
bool wasMiddle21 = math.abs(ret21[1] - prevMean) < (prevStd * dimThreshold)
bool wasMiddle22 = math.abs(ret22[1] - prevMean) < (prevStd * dimThreshold)
bool wasMiddle23 = math.abs(ret23[1] - prevMean) < (prevStd * dimThreshold)
bool wasMiddle24 = math.abs(ret24[1] - prevMean) < (prevStd * dimThreshold)
bool wasMiddle25 = math.abs(ret25[1] - prevMean) < (prevStd * dimThreshold)
bool wasMiddle26 = math.abs(ret26[1] - prevMean) < (prevStd * dimThreshold)
bool wasMiddle27 = math.abs(ret27[1] - prevMean) < (prevStd * dimThreshold)
bool wasMiddle28 = math.abs(ret28[1] - prevMean) < (prevStd * dimThreshold)
bool wasMiddle29 = math.abs(ret29[1] - prevMean) < (prevStd * dimThreshold)
bool wasMiddle30 = math.abs(ret30[1] - prevMean) < (prevStd * dimThreshold)
bool wasMiddle31 = math.abs(ret31[1] - prevMean) < (prevStd * dimThreshold)
bool wasMiddle32 = math.abs(ret32[1] - prevMean) < (prevStd * dimThreshold)

bool clusterBreakout01 = isExtreme(ret01) and wasMiddle01
bool clusterBreakout02 = isExtreme(ret02) and wasMiddle02
bool clusterBreakout03 = isExtreme(ret03) and wasMiddle03
bool clusterBreakout04 = isExtreme(ret04) and wasMiddle04
bool clusterBreakout05 = isExtreme(ret05) and wasMiddle05
bool clusterBreakout06 = isExtreme(ret06) and wasMiddle06
bool clusterBreakout07 = isExtreme(ret07) and wasMiddle07
bool clusterBreakout08 = isExtreme(ret08) and wasMiddle08
bool clusterBreakout09 = isExtreme(ret09) and wasMiddle09
bool clusterBreakout10 = isExtreme(ret10) and wasMiddle10
bool clusterBreakout11 = isExtreme(ret11) and wasMiddle11
bool clusterBreakout12 = isExtreme(ret12) and wasMiddle12
bool clusterBreakout13 = isExtreme(ret13) and wasMiddle13
bool clusterBreakout14 = isExtreme(ret14) and wasMiddle14
bool clusterBreakout15 = isExtreme(ret15) and wasMiddle15
bool clusterBreakout16 = isExtreme(ret16) and wasMiddle16
bool clusterBreakout17 = isExtreme(ret17) and wasMiddle17
bool clusterBreakout18 = isExtreme(ret18) and wasMiddle18
bool clusterBreakout19 = isExtreme(ret19) and wasMiddle19
bool clusterBreakout20 = isExtreme(ret20) and wasMiddle20
bool clusterBreakout21 = isExtreme(ret21) and wasMiddle21
bool clusterBreakout22 = isExtreme(ret22) and wasMiddle22
bool clusterBreakout23 = isExtreme(ret23) and wasMiddle23
bool clusterBreakout24 = isExtreme(ret24) and wasMiddle24
bool clusterBreakout25 = isExtreme(ret25) and wasMiddle25
bool clusterBreakout26 = isExtreme(ret26) and wasMiddle26
bool clusterBreakout27 = isExtreme(ret27) and wasMiddle27
bool clusterBreakout28 = isExtreme(ret28) and wasMiddle28
bool clusterBreakout29 = isExtreme(ret29) and wasMiddle29
bool clusterBreakout30 = isExtreme(ret30) and wasMiddle30
bool clusterBreakout31 = isExtreme(ret31) and wasMiddle31
bool clusterBreakout32 = isExtreme(ret32) and wasMiddle32

bool anyClusterBreakout = clusterBreakout01 or clusterBreakout02 or clusterBreakout03 or clusterBreakout04 or
                          clusterBreakout05 or clusterBreakout06 or clusterBreakout07 or clusterBreakout08 or
                          clusterBreakout09 or clusterBreakout10 or clusterBreakout11 or clusterBreakout12 or
                          clusterBreakout13 or clusterBreakout14 or clusterBreakout15 or clusterBreakout16 or
                          clusterBreakout17 or clusterBreakout18 or clusterBreakout19 or clusterBreakout20 or
                          clusterBreakout21 or clusterBreakout22 or clusterBreakout23 or clusterBreakout24 or
                          clusterBreakout25 or clusterBreakout26 or clusterBreakout27 or clusterBreakout28 or
                          clusterBreakout29 or clusterBreakout30 or clusterBreakout31 or clusterBreakout32

// ============================================
// ALERT CONDITIONS
// ============================================
alertcondition(anyBreakout and canAlertBreakout and enableAlerts and barstate.isconfirmed, title="Breakout Alert", message="Asset breakout detected!")
alertcondition(btcAltDivergenceAlert and canAlertDivergence and enableAlerts and barstate.isconfirmed, title="BTC vs Altcoin Divergence", message="BTC diverging from altcoins!")
alertcondition(ethBtcDivergenceAlert and canAlertDivergence and enableAlerts and barstate.isconfirmed, title="ETH vs BTC Divergence", message="ETH diverging from BTC!")
alertcondition(capDivergenceAlert and canAlertDivergence and enableAlerts and barstate.isconfirmed, title="Large vs Small Cap Divergence", message="Large caps diverging from small caps!")
alertcondition(spreadAlert and canAlertSpread and enableAlerts and barstate.isconfirmed, title="Spread Alert", message="Market spread exceeds threshold!")
alertcondition(newLeader and enableAlerts and barstate.isconfirmed, title="New Leader", message="New market leader detected!")
alertcondition(newLaggard and enableAlerts and barstate.isconfirmed, title="New Laggard", message="New market laggard detected!")
alertcondition(anyClusterBreakout and enableAlerts and barstate.isconfirmed, title="Cluster Breakout", message="Asset broke out of middle cluster!")

bool combinedAlertCondition = ((anyBreakout and canAlertBreakout) or (btcAltDivergenceAlert and canAlertDivergence) or (spreadAlert and canAlertSpread) or newLeader or newLaggard) and barstate.isconfirmed
alertcondition(combinedAlertCondition, title="Any Spaghetti Alert", message="Spaghetti indicator alert triggered!")

// ============================================
// PLOT LINES
// ============================================
plot(topVal01, "Top 1", color=topCol01, linewidth=lineWidth, display=display.pane)
plot(topVal02, "Top 2", color=topCol02, linewidth=lineWidth, display=display.pane)
plot(topVal03, "Top 3", color=topCol03, linewidth=lineWidth, display=display.pane)
plot(topVal04, "Top 4", color=topCol04, linewidth=lineWidth, display=display.pane)
plot(topVal05, "Top 5", color=topCol05, linewidth=lineWidth, display=display.pane)
plot(topVal06, "Top 6", color=topCol06, linewidth=lineWidth, display=display.pane)
plot(topVal07, "Top 7", color=topCol07, linewidth=lineWidth, display=display.pane)
plot(topVal08, "Top 8", color=topCol08, linewidth=lineWidth, display=display.pane)
plot(topVal09, "Top 9", color=topCol09, linewidth=lineWidth, display=display.pane)
plot(topVal10, "Top 10", color=topCol10, linewidth=lineWidth, display=display.pane)

plot(botVal01, "Bottom 1", color=botCol01, linewidth=lineWidth, display=display.pane)
plot(botVal02, "Bottom 2", color=botCol02, linewidth=lineWidth, display=display.pane)
plot(botVal03, "Bottom 3", color=botCol03, linewidth=lineWidth, display=display.pane)
plot(botVal04, "Bottom 4", color=botCol04, linewidth=lineWidth, display=display.pane)
plot(botVal05, "Bottom 5", color=botCol05, linewidth=lineWidth, display=display.pane)
plot(botVal06, "Bottom 6", color=botCol06, linewidth=lineWidth, display=display.pane)
plot(botVal07, "Bottom 7", color=botCol07, linewidth=lineWidth, display=display.pane)
plot(botVal08, "Bottom 8", color=botCol08, linewidth=lineWidth, display=display.pane)
plot(botVal09, "Bottom 9", color=botCol09, linewidth=lineWidth, display=display.pane)
plot(botVal10, "Bottom 10", color=botCol10, linewidth=lineWidth, display=display.pane)

hline(showZeroLine ? 0 : na, "Zero", color=color.gray, linestyle=hline.style_dashed)

plot(showBands ? meanRet + stdRet * 2 : na, "Upper Band", color=color.new(color.green, 80), style=plot.style_stepline)
plot(showBands ? meanRet - stdRet * 2 : na, "Lower Band", color=color.new(color.red, 80), style=plot.style_stepline)
plot(showMeanLine ? meanRet : na, "Mean", color=color.new(color.white, 70), style=plot.style_stepline)

// ============================================
// BREAKOUT LABELS
// ============================================
if showBreakoutLabels and anyBreakout and canAlertBreakout
    if breakout01
        label.new(bar_index, ret01, "BTC\n" + str.tostring(change01, "#.#") + "%", color=change01 > 0 ? color.green : color.red, textcolor=color.white, size=size.tiny, style=label.style_label_down)
    if breakout02
        label.new(bar_index, ret02, "ETH\n" + str.tostring(change02, "#.#") + "%", color=change02 > 0 ? color.green : color.red, textcolor=color.white, size=size.tiny, style=label.style_label_down)
    if breakout05
        label.new(bar_index, ret05, "SOL\n" + str.tostring(change05, "#.#") + "%", color=change05 > 0 ? color.green : color.red, textcolor=color.white, size=size.tiny, style=label.style_label_down)

// ============================================
// DIVERGENCE LABELS
// ============================================
if showDivergenceLabels and btcAltDivergenceAlert and canAlertDivergence
    string divDir = btcAltDivergence > 0 ? "BTC > Alts" : "Alts > BTC"
    label.new(bar_index, meanRet, "DIV\n" + divDir, color=color.purple, textcolor=color.white, size=size.tiny, style=label.style_diamond)

// ============================================
// SORTED PERFORMANCE TABLE
// ============================================
string tablePos = switch tablePosition
    "Top Right" => position.top_right
    "Top Left" => position.top_left
    "Bottom Right" => position.bottom_right
    => position.bottom_left

if showTable and barstate.islast
    var color[] colors = array.from(c01, c02, c03, c04, c05, c06, c07, c08, c09, c10, c11, c12, c13, c14, c15, c16, c17, c18, c19, c20, c21, c22, c23, c24, c25, c26, c27, c28, c29, c30, c31, c32)

    float[] returns = array.from(ret01, ret02, ret03, ret04, ret05, ret06, ret07, ret08, ret09, ret10, ret11, ret12, ret13, ret14, ret15, ret16, ret17, ret18, ret19, ret20, ret21, ret22, ret23, ret24, ret25, ret26, ret27, ret28, ret29, ret30, ret31, ret32)

    int[] indices = array.new_int(32)
    for i = 0 to 31
        array.set(indices, i, i)

    for i = 0 to 30
        for j = 0 to 30 - i
            if array.get(returns, array.get(indices, j)) < array.get(returns, array.get(indices, j + 1))
                int temp = array.get(indices, j)
                array.set(indices, j, array.get(indices, j + 1))
                array.set(indices, j + 1, temp)

    var table perfTable = table.new(tablePos, 3, 22, bgcolor=color.new(#1a1a2e, 10), border_width=0)

    table.cell(perfTable, 0, 0, "#", bgcolor=color.new(#16213e, 0), text_color=color.gray, text_size=size.normal)
    table.cell(perfTable, 1, 0, "Coin", bgcolor=color.new(#16213e, 0), text_color=color.gray, text_size=size.normal)
    table.cell(perfTable, 2, 0, "%", bgcolor=color.new(#16213e, 0), text_color=color.gray, text_size=size.normal)

    for i = 0 to 19
        int tableRow = i + 1
        int sortIdx = i < 10 ? i : 12 + i
        int idx = array.get(indices, sortIdx)
        string ticker = array.get(tickerNames, idx)
        float ret = array.get(returns, idx)
        color col = array.get(colors, idx)
        color retCol = ret > 0 ? color.new(#00ff88, 0) : color.new(#ff4757, 0)
        string rankStr = str.tostring(sortIdx + 1)
        color rowBg = i < 10 ? color.new(#0f3460, 80) : color.new(#3d0f0f, 80)

        table.cell(perfTable, 0, tableRow, rankStr, bgcolor=rowBg, text_color=color.gray, text_size=size.normal)
        table.cell(perfTable, 1, tableRow, ticker, bgcolor=rowBg, text_color=col, text_size=size.normal)
        table.cell(perfTable, 2, tableRow, str.tostring(ret, "#.##") + "%", bgcolor=rowBg, text_color=retCol, text_size=size.normal)

    table.cell(perfTable, 0, 21, "", bgcolor=color.new(#16213e, 0))
    table.cell(perfTable, 1, 21, "Spread", bgcolor=color.new(#16213e, 0), text_color=color.gray, text_size=size.normal)
    table.cell(perfTable, 2, 21, str.tostring(spreadRet, "#.#") + "%", bgcolor=color.new(#16213e, 0), text_color=spreadAlert ? color.yellow : color.white, text_size=size.normal)

// ============================================
// DYNAMIC END LABELS
// ============================================
var label[] endLabels = array.new_label(20, na)

if showEndLabels and barstate.islast
    for i = 0 to array.size(endLabels) - 1
        label oldLabel = array.get(endLabels, i)
        if not na(oldLabel)
            label.delete(oldLabel)

    float[] endReturns = array.from(ret01, ret02, ret03, ret04, ret05, ret06, ret07, ret08, ret09, ret10, ret11, ret12, ret13, ret14, ret15, ret16, ret17, ret18, ret19, ret20, ret21, ret22, ret23, ret24, ret25, ret26, ret27, ret28, ret29, ret30, ret31, ret32)

    color[] endColors = array.from(c01, c02, c03, c04, c05, c06, c07, c08, c09, c10, c11, c12, c13, c14, c15, c16, c17, c18, c19, c20, c21, c22, c23, c24, c25, c26, c27, c28, c29, c30, c31, c32)

    int[] labelIndices = array.new_int(32)
    for i = 0 to 31
        array.set(labelIndices, i, i)

    for i = 0 to 30
        for j = 0 to 30 - i
            int idxJ = array.get(labelIndices, j)
            int idxJ1 = array.get(labelIndices, j + 1)
            if array.get(endReturns, idxJ) < array.get(endReturns, idxJ1)
                array.set(labelIndices, j, idxJ1)
                array.set(labelIndices, j + 1, idxJ)

    int labelCount = 0
    for i = 0 to 31
        int idx = array.get(labelIndices, i)
        float retVal = array.get(endReturns, idx)
        string ticker = array.get(tickerNames, idx)
        color symColor = array.get(endColors, idx)

        if i < 10 or i > 21
            label newLabel = label.new(bar_index + 3, retVal, ticker, style=label.style_none, textcolor=symColor, size=size.small)
            array.set(endLabels, labelCount, newLabel)
            labelCount += 1
