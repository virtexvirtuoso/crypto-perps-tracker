//@version=6
// Spaghetti Performance Indicator v6
// Compares multiple assets relative to the chart's main symbol
// Shows which assets are outperforming or underperforming
indicator("Multi-Asset Spaghetti v6", shorttitle="Spaghetti v6", overlay=true, max_labels_count=500)

// ============================================
// TIME SETTINGS
// ============================================
string gTime = "Time Settings"
string modeInput = input.string("Rolling", "Lookback Mode", options=["Rolling", "Anchor Date", "Zoom (Visible)"], group=gTime)
int lookbackInput = input.int(360, "Rolling Bars Lookback", minval=1, maxval=1000, group=gTime)
int timezoneOffset = input.int(0, "Your Timezone in UTC", minval=-12, maxval=14, group=gTime)
int anchorYear = input.int(2025, "Year", minval=2020, maxval=2030, group=gTime)
int anchorMonth = input.int(1, "Month", minval=1, maxval=12, group=gTime)
int anchorDay = input.int(1, "Day", minval=1, maxval=31, group=gTime)
int anchorHour = input.int(0, "Hours", minval=0, maxval=23, inline="time", group=gTime)
int anchorMinute = input.int(0, "Minutes", minval=0, maxval=59, inline="time", group=gTime)
int anchorSecond = input.int(0, "Seconds", minval=0, maxval=59, inline="time", group=gTime)

int anchorTime = timestamp(anchorYear, anchorMonth, anchorDay, anchorHour, anchorMinute, anchorSecond) - (timezoneOffset * 60 * 60 * 1000)

// ============================================
// TABLE SETTINGS
// ============================================
string gTable = "Table Settings"
string tablePosition = input.string("Top Right", "Screen Location", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=gTable)
bool showTable = input.bool(true, "Show Performance Table", group=gTable)
float highlightPct = input.float(5.0, "Percentage of Assets Highlighted", minval=1.0, maxval=50.0, group=gTable)
string displayType = input.string("All Assets", "Display Type", options=["All Assets", "Outliers Only", "Leaders Only", "Laggards Only"], group=gTable)
int clusteredTransparency = input.int(80, "Clustered Assets Transparency", minval=0, maxval=100, group=gTable)
color tableTextColor = input.color(color.white, "Table Text Color", group=gTable)

// ============================================
// LABEL SETTINGS
// ============================================
string gLabel = "Label Settings"
bool showZeroLine = input.bool(true, "Show Zero Line", group=gLabel)
bool showEndLabels = input.bool(true, "Show End Labels", group=gLabel)
int lineWidth = input.int(2, "Line Width", minval=1, maxval=4, group=gLabel)

// ============================================
// DISPLAY SETTINGS
// ============================================
string gDisplay = "Display Settings"
bool relativeMode = input.bool(true, "Relative to Chart Symbol", group=gDisplay, tooltip="Compare all assets relative to the chart's main symbol.")
bool autoDim = input.bool(true, "Auto-Dim Clustered Assets", group=gDisplay)
float dimThreshold = input.float(1.0, "Dim Threshold (Std Dev)", minval=0.5, maxval=3.0, group=gDisplay)
bool showBands = input.bool(true, "Show Std Dev Bands", group=gDisplay)
bool showMeanLine = input.bool(true, "Show Mean Line", group=gDisplay)

// ============================================
// ALERT SETTINGS
// ============================================
string gAlert = "Alert Settings"
bool enableAlerts = input.bool(true, "Enable Alerts", group=gAlert)
float breakoutThreshold = input.float(5.0, "Breakout Threshold (%)", minval=1.0, maxval=50.0, group=gAlert)
float divergenceThreshold = input.float(10.0, "Divergence Threshold (%)", minval=2.0, maxval=50.0, group=gAlert)
float spreadThreshold = input.float(20.0, "Spread Alert Threshold (%)", minval=5.0, maxval=100.0, group=gAlert)
int alertCooldown = input.int(5, "Alert Cooldown (bars)", minval=1, maxval=50, group=gAlert)
bool showBreakoutLabels = input.bool(true, "Show Breakout Labels", group=gAlert)
bool showDivergenceLabels = input.bool(true, "Show Divergence Labels", group=gAlert)

