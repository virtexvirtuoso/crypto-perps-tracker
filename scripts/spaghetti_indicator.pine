float p06 = request.security(sym06, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p07 = request.security(sym07, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p08 = request.security(sym08, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p09 = request.security(sym09, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p10 = request.security(sym10, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p11 = request.security(sym11, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p12 = request.security(sym12, timeframe.period, close, lookahead=barmerge.lookahead_off)
