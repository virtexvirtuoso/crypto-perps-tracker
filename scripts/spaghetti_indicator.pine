color c32 = input.color(#00CED1, "C32", inline="c6", group=gColors)  // XPIN Turquoise

// Symbol names for alerts
var string[] symNames = array.from("BINANCE:BTCUSDT.P", "BINANCE:ETHUSDT.P", "BINANCE:XRPUSDT.P", "BINANCE:BNBUSDT.P", "BINANCE:SOLUSDT.P", "BINANCE:DOGEUSDT.P", "BINANCE:AVAXUSDT.P", "BINANCE:LINKUSDT.P", "BINANCE:TNSRUSDT.P", "BINANCE:ZECUSDT.P", "BINANCE:XMRUSDT.P", "BINANCE:ICPUSDT.P", "BINANCE:TRXUSDT.P", "BINANCE:LTCUSDT.P", "BINANCE:KASUSDT.P", "BINANCE:ETCUSDT.P", "BINANCE:NEARUSDT.P", "BINANCE:ATOMUSDT.P", "BINANCE:GRASSUSDT.P", "BINANCE:HYPEUSDT.P", "BINANCE:WLDUSDT.P", "BINANCE:ONDOUSDT.P", "BINANCE:FARTCOINUSDT.P", "BINANCE:PIPPINUSDT.P", "BINANCE:PIEVERSEUSDT.P", "BINANCE:JELLYJELLYUSDT.P", "BINANCE:EDENUSDT.P", "BINANCE:TAKEUSDT.P", "BINANCE:MYXUSDT.P", "BINANCE:OGUSDT.P", "BINANCE:FFUSDT.P", "BINANCE:XPINUSDT.P")

// Short ticker names for table and labels
var string[] tickerNames = array.from("BTC", "ETH", "XRP", "BNB", "SOL", "DOGE", "AVAX", "LINK", "TNSR", "ZEC", "XMR", "ICP", "TRX", "LTC", "KAS", "ETC", "NEAR", "ATOM", "GRASS", "HYPE", "WLD", "ONDO", "FARTCOIN", "PIPPIN", "PIEVERSE", "JELLY", "EDEN", "TAKE", "MYX", "OG", "FF", "XPIN")

// ============================================
// FETCH PRICE DATA (with lookahead=off to prevent repainting)
// ============================================
float p01 = request.security(sym01, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p02 = request.security(sym02, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p03 = request.security(sym03, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p04 = request.security(sym04, timeframe.period, close, lookahead=barmerge.lookahead_off)
