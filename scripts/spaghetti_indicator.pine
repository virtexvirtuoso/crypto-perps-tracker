getColorByIdx(int idx) =>
    switch idx
        0 => c01
        1 => c02
        2 => c03
        3 => c04
        4 => c05
        5 => c06
        6 => c07
        7 => c08
        8 => c09
        9 => c10
        10 => c11
        11 => c12
        12 => c13
        13 => c14
        14 => c15
        15 => c16
        16 => c17
        17 => c18
        18 => c19
        19 => c20
        20 => c21
        21 => c22
        22 => c23
        23 => c24
        24 => c25
        25 => c26
        26 => c27
        27 => c28
        28 => c29
        29 => c30
        30 => c31
        => c32

// Get dynamic values for top 10 slots
float topVal01 = getRetByIdx(array.get(topIndices, 0))
float topVal02 = getRetByIdx(array.get(topIndices, 1))
float topVal03 = getRetByIdx(array.get(topIndices, 2))
float topVal04 = getRetByIdx(array.get(topIndices, 3))
float topVal05 = getRetByIdx(array.get(topIndices, 4))
float topVal06 = getRetByIdx(array.get(topIndices, 5))
float topVal07 = getRetByIdx(array.get(topIndices, 6))
float topVal08 = getRetByIdx(array.get(topIndices, 7))
float topVal09 = getRetByIdx(array.get(topIndices, 8))
float topVal10 = getRetByIdx(array.get(topIndices, 9))

// Get dynamic values for bottom 10 slots
float botVal01 = getRetByIdx(array.get(bottomIndices, 0))
float botVal02 = getRetByIdx(array.get(bottomIndices, 1))
float botVal03 = getRetByIdx(array.get(bottomIndices, 2))
float botVal04 = getRetByIdx(array.get(bottomIndices, 3))
