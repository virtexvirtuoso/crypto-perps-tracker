float p14 = request.security(sym14, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p15 = request.security(sym15, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p16 = request.security(sym16, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p17 = request.security(sym17, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p18 = request.security(sym18, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p19 = request.security(sym19, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p20 = request.security(sym20, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p21 = request.security(sym21, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p22 = request.security(sym22, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p23 = request.security(sym23, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p24 = request.security(sym24, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p25 = request.security(sym25, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p26 = request.security(sym26, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p27 = request.security(sym27, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p28 = request.security(sym28, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p29 = request.security(sym29, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p30 = request.security(sym30, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p31 = request.security(sym31, timeframe.period, close, lookahead=barmerge.lookahead_off)
float p32 = request.security(sym32, timeframe.period, close, lookahead=barmerge.lookahead_off)

// ============================================
// RETURN CALCULATION FUNCTIONS
// ============================================

// Get base price based on mode
// Note: ta.valuewhen must be called on every bar for consistency
getBasePrice(float price, string mode, int lookback) =>
    // Call ta.valuewhen unconditionally (required by Pine Script)
    float anchorPrice = ta.valuewhen(time >= anchorTime and time[1] < anchorTime, price, 0)
    float result = na
    if mode == "Rolling"
        result := price[lookback]
    else if mode == "Anchor Date"
        result := na(anchorPrice) ? price[lookback] : anchorPrice  // Use fallback if na
    else if mode == "Zoom (Visible)"
        // Use the visible range - approximated by using bar_index limited to max lookback
        result := price[math.min(bar_index, 500)]
    result

// Calculate percentage return
calcReturn(float price, float basePrice) =>
    basePrice > 0 ? ((price - basePrice) / basePrice) * 100 : 0.0

// ============================================
// CHART SYMBOL (for relative comparison)
// ============================================
float chartPrice = close
float chartBase = getBasePrice(chartPrice, modeInput, lookbackInput)
float chartReturn = calcReturn(chartPrice, chartBase)

// ============================================
// CALCULATE ALL RETURNS
// ============================================
base01 = getBasePrice(p01, modeInput, lookbackInput)
base02 = getBasePrice(p02, modeInput, lookbackInput)
base03 = getBasePrice(p03, modeInput, lookbackInput)
base04 = getBasePrice(p04, modeInput, lookbackInput)
base05 = getBasePrice(p05, modeInput, lookbackInput)
base06 = getBasePrice(p06, modeInput, lookbackInput)
base07 = getBasePrice(p07, modeInput, lookbackInput)
base08 = getBasePrice(p08, modeInput, lookbackInput)
base09 = getBasePrice(p09, modeInput, lookbackInput)
base10 = getBasePrice(p10, modeInput, lookbackInput)
base11 = getBasePrice(p11, modeInput, lookbackInput)
base12 = getBasePrice(p12, modeInput, lookbackInput)
base13 = getBasePrice(p13, modeInput, lookbackInput)
base14 = getBasePrice(p14, modeInput, lookbackInput)
base15 = getBasePrice(p15, modeInput, lookbackInput)
base16 = getBasePrice(p16, modeInput, lookbackInput)
base17 = getBasePrice(p17, modeInput, lookbackInput)
base18 = getBasePrice(p18, modeInput, lookbackInput)
base19 = getBasePrice(p19, modeInput, lookbackInput)
base20 = getBasePrice(p20, modeInput, lookbackInput)
base21 = getBasePrice(p21, modeInput, lookbackInput)
base22 = getBasePrice(p22, modeInput, lookbackInput)
base23 = getBasePrice(p23, modeInput, lookbackInput)
base24 = getBasePrice(p24, modeInput, lookbackInput)
base25 = getBasePrice(p25, modeInput, lookbackInput)
base26 = getBasePrice(p26, modeInput, lookbackInput)
base27 = getBasePrice(p27, modeInput, lookbackInput)
base28 = getBasePrice(p28, modeInput, lookbackInput)
base29 = getBasePrice(p29, modeInput, lookbackInput)
base30 = getBasePrice(p30, modeInput, lookbackInput)
base31 = getBasePrice(p31, modeInput, lookbackInput)
base32 = getBasePrice(p32, modeInput, lookbackInput)

// Calculate raw returns
float rawRet01 = calcReturn(p01, base01)
float rawRet02 = calcReturn(p02, base02)
float rawRet03 = calcReturn(p03, base03)
float rawRet04 = calcReturn(p04, base04)
float rawRet05 = calcReturn(p05, base05)
float rawRet06 = calcReturn(p06, base06)
float rawRet07 = calcReturn(p07, base07)
float rawRet08 = calcReturn(p08, base08)
float rawRet09 = calcReturn(p09, base09)
float rawRet10 = calcReturn(p10, base10)
float rawRet11 = calcReturn(p11, base11)
float rawRet12 = calcReturn(p12, base12)
float rawRet13 = calcReturn(p13, base13)
float rawRet14 = calcReturn(p14, base14)
float rawRet15 = calcReturn(p15, base15)
float rawRet16 = calcReturn(p16, base16)
float rawRet17 = calcReturn(p17, base17)
float rawRet18 = calcReturn(p18, base18)
float rawRet19 = calcReturn(p19, base19)
float rawRet20 = calcReturn(p20, base20)
float rawRet21 = calcReturn(p21, base21)
float rawRet22 = calcReturn(p22, base22)
float rawRet23 = calcReturn(p23, base23)
float rawRet24 = calcReturn(p24, base24)
float rawRet25 = calcReturn(p25, base25)
float rawRet26 = calcReturn(p26, base26)
float rawRet27 = calcReturn(p27, base27)
float rawRet28 = calcReturn(p28, base28)
float rawRet29 = calcReturn(p29, base29)
float rawRet30 = calcReturn(p30, base30)
float rawRet31 = calcReturn(p31, base31)
float rawRet32 = calcReturn(p32, base32)

// Apply relative mode: subtract chart symbol return to show outperformance/underperformance
float relAdj = relativeMode ? chartReturn : 0.0
float ret01 = rawRet01 - relAdj
float ret02 = rawRet02 - relAdj
float ret03 = rawRet03 - relAdj
float ret04 = rawRet04 - relAdj
float ret05 = rawRet05 - relAdj
float ret06 = rawRet06 - relAdj
float ret07 = rawRet07 - relAdj
float ret08 = rawRet08 - relAdj
float ret09 = rawRet09 - relAdj
float ret10 = rawRet10 - relAdj
float ret11 = rawRet11 - relAdj
float ret12 = rawRet12 - relAdj
float ret13 = rawRet13 - relAdj
float ret14 = rawRet14 - relAdj
float ret15 = rawRet15 - relAdj
float ret16 = rawRet16 - relAdj
float ret17 = rawRet17 - relAdj
float ret18 = rawRet18 - relAdj
float ret19 = rawRet19 - relAdj
float ret20 = rawRet20 - relAdj
float ret21 = rawRet21 - relAdj
float ret22 = rawRet22 - relAdj
float ret23 = rawRet23 - relAdj
float ret24 = rawRet24 - relAdj
float ret25 = rawRet25 - relAdj
float ret26 = rawRet26 - relAdj
float ret27 = rawRet27 - relAdj
float ret28 = rawRet28 - relAdj
float ret29 = rawRet29 - relAdj
float ret30 = rawRet30 - relAdj
float ret31 = rawRet31 - relAdj
float ret32 = rawRet32 - relAdj

// ============================================
// AUTO-DIMMING LOGIC
// ============================================
float[] retArray = array.from(ret01, ret02, ret03, ret04, ret05, ret06, ret07, ret08, ret09, ret10, ret11, ret12, ret13, ret14, ret15, ret16, ret17, ret18, ret19, ret20, ret21, ret22, ret23, ret24, ret25, ret26, ret27, ret28, ret29, ret30, ret31, ret32)

float meanRet = array.avg(retArray)
float stdRet = array.stdev(retArray)
float maxRet = array.max(retArray)
float minRet = array.min(retArray)
float spreadRet = maxRet - minRet

// Calculate percentile thresholds for highlighting
int numAssets = 32
int numHighlight = math.round(numAssets * (highlightPct / 100))
float[] sortedRets = array.copy(retArray)
array.sort(sortedRets, order.descending)
float topThreshold = array.get(sortedRets, math.max(0, numHighlight - 1))
float bottomThreshold = array.get(sortedRets, math.min(31, 32 - numHighlight))

// ============================================
// DYNAMIC PLOT ASSIGNMENT (20 slots for 32 symbols)
// Assigns top 10 and bottom 10 performers to fixed plot slots
// This keeps us under TradingView's 64 plot limit
// ============================================

// Create sorted index array to find top/bottom performers
int[] sortedIndices = array.new_int(32)
for i = 0 to 31
    array.set(sortedIndices, i, i)

// Sort indices by return value (descending)
for i = 0 to 30
    for j = 0 to 30 - i
        int idxJ = array.get(sortedIndices, j)
        int idxJ1 = array.get(sortedIndices, j + 1)
        if array.get(retArray, idxJ) < array.get(retArray, idxJ1)
            array.set(sortedIndices, j, idxJ1)
            array.set(sortedIndices, j + 1, idxJ)

// Get indices for top 10 and bottom 10 performers
var int[] topIndices = array.new_int(10, 0)
var int[] bottomIndices = array.new_int(10, 0)
for i = 0 to 9
    array.set(topIndices, i, array.get(sortedIndices, i))           // Top 10
    array.set(bottomIndices, i, array.get(sortedIndices, 31 - i))   // Bottom 10

// Helper function: get return value by index
getRetByIdx(int idx) =>
    switch idx
        0 => ret01
        1 => ret02
        2 => ret03
        3 => ret04
        4 => ret05
        5 => ret06
        6 => ret07
        7 => ret08
        8 => ret09
        9 => ret10
        10 => ret11
        11 => ret12
        12 => ret13
        13 => ret14
        14 => ret15
        15 => ret16
        16 => ret17
        17 => ret18
        18 => ret19
        19 => ret20
        20 => ret21
        21 => ret22
        22 => ret23
        23 => ret24
        24 => ret25
        25 => ret26
        26 => ret27
        27 => ret28
        28 => ret29
        29 => ret30
        30 => ret31
        => ret32

